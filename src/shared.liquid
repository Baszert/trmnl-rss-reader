{% comment %} Only fetch the Google Font (and its CSS rule) when the heading_font setting asks for it - the "default" option should not load anything extra {% endcomment %}
{% assign heading_font = trmnl.plugin_settings.custom_fields_values.heading_font | default: "custom" %}

{% if heading_font == "newsletter" %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gloock&display=swap" rel="stylesheet">

<style>
  article h1,
  article h2,
  article h3,
  article h4,
  article h5,
  article h6 {
    font-family: "Gloock", serif;
    font-weight: 400;
    font-style: normal;
  }
</style>
{% endif %}

<style>

  p {
    line-height: 1.6em;
  }

  h1 {
    line-height: 1.2em;
  }
</style>

{% comment %} Feed items 1-6, normalized by transform.js (same shape for RSS 2.0, RSS 1.0/RDF and Atom) {% endcomment %}
{% assign firstArticle = first %}
{% assign secondArticle = second %}
{% assign thirdArticle = third %}
{% assign fourthArticle = fourth %}
{% assign fifthArticle = fifth %}
{% assign sixthArticle = sixth %}

{% comment %}
  Whether each article was published today - templates hide the date and show
  only the time when true. Liquid quirk: comparing a filtered value directly in
  an {% if %}/{% unless %} condition (e.g. "x | date: '...' == y") silently
  always evaluates true, so the filtered value must be assigned to a plain
  variable first and compared separately.
{% endcomment %}
{% assign today_key = trmnl.system.timestamp_utc | date: "%Y-%m-%d" %}

{% assign firstArticle_day = firstArticle.date | date: "%Y-%m-%d" %}
{% assign firstArticle_is_today = false %}
{% if firstArticle_day == today_key %}{% assign firstArticle_is_today = true %}{% endif %}

{% assign secondArticle_day = secondArticle.date | date: "%Y-%m-%d" %}
{% assign secondArticle_is_today = false %}
{% if secondArticle_day == today_key %}{% assign secondArticle_is_today = true %}{% endif %}

{% assign thirdArticle_day = thirdArticle.date | date: "%Y-%m-%d" %}
{% assign thirdArticle_is_today = false %}
{% if thirdArticle_day == today_key %}{% assign thirdArticle_is_today = true %}{% endif %}

{% assign fourthArticle_day = fourthArticle.date | date: "%Y-%m-%d" %}
{% assign fourthArticle_is_today = false %}
{% if fourthArticle_day == today_key %}{% assign fourthArticle_is_today = true %}{% endif %}

{% assign fifthArticle_day = fifthArticle.date | date: "%Y-%m-%d" %}
{% assign fifthArticle_is_today = false %}
{% if fifthArticle_day == today_key %}{% assign fifthArticle_is_today = true %}{% endif %}

{% assign sixthArticle_day = sixthArticle.date | date: "%Y-%m-%d" %}
{% assign sixthArticle_is_today = false %}
{% if sixthArticle_day == today_key %}{% assign sixthArticle_is_today = true %}{% endif %}

{% comment %} Weather sidebar (Open-Meteo, IDX_1) {% endcomment %}
{% assign weatherCode = weather.current.weathercode %}
{% assign curTemp = weather.current.temperature_2m %}
{% assign dailyLow = weather.daily.temperature_2m_min %}
{% assign dailyHigh = weather.daily.temperature_2m_max %}

{% comment %} true only when Open-Meteo actually returned data - lets the weather widget show an error instead of silently guessing "cloudy" {% endcomment %}
{% assign weather_ok = false %}
{% if curTemp != blank and weatherCode != blank %}
  {% assign weather_ok = true %}
{% endif %}

{% assign weatherCategory = "" %}
{% case weatherCode %}
{% when 0, 1 %}
{% assign weatherCategory = "sunny" %}
{% when 2, 3 %}
{% assign weatherCategory = "cloudy" %}
{% when 45, 48 %}
{% assign weatherCategory = "foggy" %}
{% when 51, 53, 55, 56, 57 %}
{% assign weatherCategory = "drizzle" %}
{% when 61, 63, 80, 81 %}
{% assign weatherCategory = "rain" %}
{% when 65, 82 %}
{% assign weatherCategory = "heavy_rain" %}
{% when 66, 67 %}
{% assign weatherCategory = "freezing_rain" %}
{% when 71, 73, 85 %}
{% assign weatherCategory = "snow" %}
{% when 75, 77, 86 %}
{% assign weatherCategory = "heavy_snow" %}
{% when 95, 96, 99 %}
{% assign weatherCategory = "storm" %}
{% else %}
{% assign weatherCategory = "cloudy" %}
{% endcase %}

{% comment %} Date/time display format, from the date_format / time_format custom fields {% endcomment %}
{% assign date_format = trmnl.plugin_settings.custom_fields_values.date_format %}
{% assign date_pattern = "%d-%m-%Y" %}
{% if date_format == "us" %}
  {% assign date_pattern = "%m/%d/%Y" %}
{% endif %}

{% assign time_pattern = "%H:%M" %}
{% assign time_format = trmnl.plugin_settings.custom_fields_values.time_format %}
{% if time_format == "12h" %}
  {% assign time_pattern = "%I:%M %p" %}
{% endif %}

{% assign no_image = "https://trmnl.achtnegen.nl/rss/no-image.jpg" %}

